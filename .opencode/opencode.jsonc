{
  "$schema": "https://opencode.ai/config.json",
  "username": "cmbntr",
  "autoupdate": false,
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "plan",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
    },
    "plan": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
    },
    "general": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium",
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium",
    },
    "compaction": {
      "model": "openai/gpt-5.6-luna",
      "variant": "minimal",
    },
    "summary": {
      "model": "openai/gpt-5-mini",
      "variant": "minimal",
    },
    "title": {
      "model": "openai/gpt-5-nano",
      "variant": "none",
    },
    "code-reviewer-sonnet": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "primary",
      "model": "opencode/claude-sonnet-5",
      "color": "#808000",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "tools": {
        "write": false,
        "edit": false,
      },
    },
    "code-reviewer-kimi": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "primary",
      "model": "opencode/kimi-k2.7-code",
      "color": "#808000",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "tools": {
        "write": false,
        "edit": false,
      },
    },
    "explore-gemini": {
      "mode": "subagent",
      "model": "opencode/gemini-3.5-flash-lite",
      "description": "Fast agent specialized for exploring codebases. Use this when you need to quickly find files by patterns (eg. \"src/components/**/*.tsx\"), search code for keywords (eg. \"API endpoints\"), or answer questions about the codebase (eg. \"how do API endpoints work?\"). When calling this agent, specify the desired thoroughness level: \"quick\" for basic searches, \"medium\" for moderate exploration, or \"very thorough\" for comprehensive analysis across multiple locations and naming conventions.",
      "prompt": "You are a file search specialist. You excel at thoroughly navigating and exploring codebases.\n\nYour strengths:\n- Rapidly finding files using glob patterns\n- Searching code and text with powerful regex patterns\n- Reading and analyzing file contents\n\nGuidelines:\n- Use Glob for broad file pattern matching\n- Use ripgrep for searching file contents with regex\n- Use Read when you know the specific file path you need to read\n- Use Bash for file operations like copying, moving, or listing directory contents\n- Adapt your search approach based on the thoroughness level specified by the caller\n- Return file paths as absolute paths in your final response\n- For clear communication, avoid using emojis\n- Do not create any files, or run bash commands that modify the user's system state in any way\n\nComplete the user's search request efficiently and report your findings clearly.\n",
      "color": "#008000",
      "permission": {
        "*": "deny",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "read": "allow",
        "external_directory": {
          "*": "ask"
        }
      }
    }
  },
  "snapshot": true,
  "permission": {
    "lsp": "allow",
    "websearch": "ask",
    "external_directory": {
      "/ram/**": "ask"
    },
    "bash": {
      "git checkout *": "ask",
      "git clean *": "ask",
      "git push *": "ask",
      "git reset *": "ask",
      "rm -rf *": "ask"
    }
  },
  "formatter": {
    "prettier": {
      "disabled": true
    },
    "uv format": {
      "disabled": true
    },
    "dprint": {
      "command": [
        "bun x dprint",
        "fmt",
        "$FILE"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".html",
        ".css",
        ".json",
        ".jsonc",
        ".toml",
        ".yaml",
        ".yml",
        ".md",
        "Dockerfile",
      ]
    }
  },
  "plugin": [
    // "opencode-beads@latest"
  ],
  "lsp": {
    "typescript": {
      "disabled": false,
      "extensions": [
        ".ts",
        ".tsx"
      ],
      "command": [
        "typescript-language-server",
        "--stdio",
        "--log-level",
        "4"
      ]
    }
  },
  "mcp": {
    "aperture": {
      "enabled": false,
      "type": "remote",
      "url": "http://aiproxy.unicorn-tegu.ts.net/v1/mcp"
    },
    "evernote": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.evernote.com/mcp",
    },
    "nori": {
      "enabled": false,
      "type": "remote",
      "url": "https://api.nori.ai/mcp",
    },
    "agent-browser": { // https://agent-browser.dev/
      "enabled": false,
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec bun x agent-browser@latest mcp"
      ],
    },
    "playwright": { // https://playwright.dev/mcp/introduction
      "enabled": false,
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec bun x @playwright/mcp@latest --isolated --headless --viewport-size 1280x720"
      ],
      "environment": {
        "PLAYWRIGHT_MCP_CAPS": "network,storage,devtools,pdf,config", // testing,vision
        "PLAYWRIGHT_MCP_USER_AGENT": "Mozilla/5.0 (X11; Linux x86_64; rv:133.0) Gecko/20100101 Firefox/133.0",
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "/opt/microsoft/msedge-dev/msedge",
        // "PLAYWRIGHT_MCP_BROWSER": "chrome", "PLAYWRIGHT_MCP_CDP_ENDPOINT": "ws://127.0.0.1:9222"
      }
    },
    "lightpanda": { // https://github.com/lightpanda-io/browser
      "enabled": false,
      "type": "local",
      "command": [
        "lightpanda", // https://github.com/lightpanda-io/browser/releases/download/nightly/lightpanda-x86_64-linux
        "mcp",
        // "--insecure-disable-tls-host-verification"
        "--user-agent",
        "Mozilla/5.0 (X11; Linux x86_64; rv:133.0) Gecko/20100101 Firefox/133.0",
        "--http-max-concurrent",
        "10",
        "--http-max-host-open",
        "4",
      ],
      "environment": {
        "LIGHTPANDA_DISABLE_TELEMETRY": "true",
        "LIGHTPANDA_DISABLE_CORE_DUMP": "true",
        // "TAVILY_API_KEY": "optional for search tool"
      }
    },
    "searxng": { // https://github.com/dandehoon/searxng-mcp
      "enabled": false,
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec podman run -i --rm --pull newer -p 18880:8080 docker.io/dandehoon/searxng-mcp"
      ],
      "environment": {
        "SEARXNG_MCP_MAX_RESULTS": "20",
      }
    },
    "searxng-namejeff": { // https://github.com/ihor-sokoliuk/mcp-searxng
      "enabled": false,
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec bun x mcp-searxng"
      ],
      "environment": {
        "SEARXNG_URL": "https://searx.namejeff.xyz/" // https://searx.space/
      }
    },
    "oreilly": { // https://learning.oreilly.com/apidocs/mcp/content/#section/Connection-Configuration
      "enabled": false,
      "type": "remote",
      "url": "https://api.oreilly.com/api/content-discovery/v1/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:OREILLY_MCP_TOKEN}"
      }
    },
    "mermaid": {
      "enabled": false,
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec bun x mcp-mermaid"
      ],
      "environment": {
        "NODE_ENV": "production"
      }
    },
    "memory": {
      "enabled": false,
      "type": "local",
      "command": [
        "sh",
        "-c",
        "LIBSQL_URL=file://$(pwd)/mcpmem.db exec bun x mcp-memory-libsql"
      ],
      "environment": {
        "NODE_ENV": "production"
      }
    },
    "libsql": {
      "enabled": false,
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec bun x @xexr/mcp-libsql --url file://$(pwd)/app.db"
      ],
      "environment": {
        "NODE_ENV": "production"
      }
    },
    "filesystem--ram": {
      "enabled": false,
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec bun x @modelcontextprotocol/server-filesystem /ram"
      ]
    },
    "firefox-devtools": { // https://github.com/mozilla/firefox-devtools-mcp
      "enabled": false,
      "type": "local",
      "command": [
        "sh",
        "-c",
        "PROFILE_DIR=$(mktemp -d) && exec bun x @mozilla/firefox-devtools-mcp@latest --headless --viewport 1280x720 --profile-path \"$PROFILE_DIR\"",
        // "exec bun x @mozilla/firefox-devtools-mcp@latest --connect-existing --marionette-port 2828"
      ],
      "environment": {
        "NODE_ENV": "production",
        "ENABLE_SCRIPT": "true",
        "TMPDIR": "/ram"
      }
    },
    "chrome-devtools": { // https://github.com/ChromeDevTools/chrome-devtools-mcp  edge://inspect/#remote-debugging
      "enabled": false,
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec bun x chrome-devtools-mcp@latest --executablePath=/opt/microsoft/msedge-dev/msedge --isolated --headless --viewport 1280x720 --slim"
        // "exec bun x chrome-devtools-mcp@latest --auto-connect --slim"
      ],
      "environment": {
        "NODE_ENV": "production",
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "true",
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "true",
        "TMPDIR": "/ram"
      }
    },
  },
  "share": "disabled",
  "experimental": {
    "openTelemetry": true
  }
}