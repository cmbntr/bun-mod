{
  "editor.formatOnSave": true,
  "editor.inlayHints.enabled": "on",
  "editor.inlayHints.maximumLength": 120,
  "orta.vscode-twoslash-queries.maxLength": 120,
  "js/ts.inlayHints.parameterNames.enabled": "literals",
  "js/ts.inlayHints.parameterTypes.enabled": true,
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  // VITEST "bun.test.enable": false,
  "[typescript]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[javascript]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[html]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[css]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[scss]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[vue]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[j2]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[json]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[snippets]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[yaml]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[toml]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[xml]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[markdown]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[nix]": {
    "editor.defaultFormatter": "kamadorueda.alejandra",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": false
  },
  "json.schemas": [
    {
      "fileMatch": [
        "opencode.json",
        "config.json"
      ],
      "url": "https://models.dev/model-schema.json"
    },
    {
      "fileMatch": [
        "opencode.json",
        "opencode.jsonc"
      ],
      "url": "https://opencode.ai/config.json"
    },
    {
      "fileMatch": [
        "tui.json",
        "tui.jsonc"
      ],
      "url": "https://opencode.ai/tui.json"
    }
  ],
  "alejandra.program": "alejandra",
  "rest-client.requestNameAsResponseTabTitle": true,
  "rest-client.environmentVariables": {
    "$shared": {
    },
    "local": {
      "scheme": "http",
      "host": "localhost",
      "port": ":3000"
    },
    "production": {
      "scheme": "http",
      "host": "localhost",
      "port": ":3000"
    }
  }
}
