{
  "excludes": [".**", "openspec/**"],
  "newLineKind": "lf",
  "lineWidth": 100,
  "typescript": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "useBraces": "always",
    "semiColons": "always",
    "quoteStyle": "alwaysDouble",
    "quoteProps": "asNeeded",
    "trailingCommas": "onlyMultiLine",
    "arrowFunction.useParentheses": "force"
  },
  "markup": {
    "indentWidth": 2,
    "printWidth": 100
  },
  "malva": {
    "indentWidth": 2,
    "printWidth": 100
  },
  "json": {
    "indentWidth": 2,
    "lineWidth": 100,
    "useTabs": false,
    "trailingCommas": "jsonc",
    "commentLine.forceSpaceAfterSlashes": false,
    "associations": [
      "**/*.{json,jsonc}",
      "**/*.code-snippets"
    ]
  },
  "yaml": {},
  "toml": {},
  "dockerfile": {},
  "markdown": {},
  "plugins": [
    "npm:@dprint/dockerfile@0.6.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/toml@0.8.0",
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/markdown@0.24.0",
    "npm:dprint-plugin-markup@0.27.3",
    "npm:dprint-plugin-malva@0.16.0"
  ]
}
