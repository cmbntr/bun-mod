{
  "name": "bun-mod",
  "module": "src/mod.ts",
  "type": "module",
  "scripts": {
    "check": "bun x tsc --noEmit",
    "test": "bun x vitest",
    "test-update": "bun x vitest --update",
    "test-coverage": "bun x vitest run --coverage",
    "madge-circular": "bun x madge --extensions ts --circular --no-color --no-spinner --warning src",
    "madge-svg": "mkdir -p out && bun x madge --extensions ts --image out/deps.svg src",
    "madge-dot": "mkdir -p out && bun x madge --extensions ts --dot src > out/deps.dot",
    "madge": "bun x madge --extensions ts src",
    "docs": "bun x typedoc",
    "docs-md": "bun x typedoc --plugin typedoc-plugin-markdown"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.2.18",
    "dprint": "^0.50.1"
  },
  "bun-create": {
    "preinstall": ["echo 'Installing...'"],
    "postinstall": ["echo 'Done!'"],
    "start": "direnv allow ; task --list ; task dev"
  }
}
