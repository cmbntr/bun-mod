{
  "name": "bun-mod",
  "version": "0.1.0",
  "private": true,
  "sideEffects": ["*.css"],
  "type": "module",
  "module": "src/mod.ts",
  "scripts": {
    "tsgo": "bun x --bun -p 'typescript@latest' tsc",
    "check": "bun x --bun tsc --noEmit",
    "test": "bun x --bun vitest --exclude '.repos/**' --passWithNoTests",
    "test-update": "bun x --bun vitest --exclude '.repos/**' --passWithNoTests --update",
    "test-coverage": "bun x --bun vitest run --exclude '.repos/**' --passWithNoTests --coverage",
    "madge-circular": "bun x madge --extensions ts --circular --no-color --no-spinner --warning src",
    "madge-svg": "mkdir -p out && bun x madge --extensions ts --image out/deps.svg src",
    "madge-dot": "mkdir -p out && bun x madge --extensions ts --dot src > out/deps.dot",
    "madge": "bun x madge --extensions ts src",
    "docs": "bun x typedoc",
    "docs-md": "bun x typedoc --plugin typedoc-plugin-markdown",
    "more": "task --list # for more developer tooling"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.2"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "dprint": "^0.57.4"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.0.0"
  },
  "bun-create": {
    "preinstall": ["echo 'Installing...'"],
    "postinstall": ["echo 'Done!'"],
    "start": "direnv allow ; task --list ; task dev"
  },
  "x-disabled-overrides": {
    "msgpackr": "npm:noop3@1000.0.0",
    "@parcel/watcher": "npm:noop3@1000.0.0"
  }
}
